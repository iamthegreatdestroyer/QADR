{
  "name": "@qadr/config",
  "version": "1.0.0",
  "description": "Configuration loading and validation for QADR",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@qadr/shared": "workspace:*",
    "cosmiconfig": "^9.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  },
  "keywords": [
    "qadr",
    "configuration",
    "config",
    "settings",
    "validation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/iamthegreatdestroyer/QADR.git",
    "directory": "packages/config"
  },
  "license": "AGPL-3.0-or-later",
  "author": "Stevo <sgbilod@proton.me>"
}
