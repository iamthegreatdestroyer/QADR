{
  "name": "@qadr/semver",
  "version": "0.0.0",
  "description": "Semantic versioning utilities for QADR - parsing, comparison, and constraint matching",
  "license": "AGPL-3.0-or-later",
  "author": {
    "name": "Stevo",
    "email": "sgbilod@proton.me"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iamthegreatdestroyer/QADR.git",
    "directory": "packages/semver"
  },
  "homepage": "https://github.com/iamthegreatdestroyer/QADR/tree/main/packages/semver#readme",
  "bugs": {
    "url": "https://github.com/iamthegreatdestroyer/QADR/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist .turbo",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@qadr/config": "workspace:*",
    "@types/node": "^20.10.0",
    "eslint": "^8.56.0",
    "rimraf": "^5.0.5",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "semver",
    "semantic-versioning",
    "version",
    "dependency",
    "constraint",
    "qadr"
  ]
}
